+    signer_commitment: &[u8],
+    signature: &[u8],
 ) -> Result<(), Error> {
     let secp = Secp256k1::new();
     let signer_commitment_pubkey = PublicKey::from_slice(signer_commitment)
@@ -143,4 +164,40 @@ mod tests {
