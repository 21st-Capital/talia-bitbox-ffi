+    signer_commitment: &[u8],
+    signature: &[u8],
+) -> Result<(), Error> {
+    crate::secp256k1::validate_signature_recoverable(signature)?;
+    verify_ecdsa_nonce(host_nonce, signer_commitment, &signature[..64])
+}
