 src/eth.rs        |  19 ++++++---
 src/lib.rs        |   1 +
 src/secp256k1.rs  | 102 ++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 178 insertions(+), 9 deletions(-)
